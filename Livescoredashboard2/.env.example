# Frontend environment variables
# Copy this file to .env and replace each placeholder with your own value.

# Paystack public key. Use pk_test_... during development.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# RapidAPI settings used by the frontend
VITE_RAPIDAPI_KEY=your_rapidapi_key
VITE_RAPIDAPI_HOST=today-football-prediction.p.rapidapi.com
VITE_ALLSPORTS_API_HOST=allsportsapi2.p.rapidapi.com
