# Hyperlink Social Hub / Supabase — Next.js (NEXT_PUBLIC_*) + Vite fallback (VITE_*)
# For Next.js, use NEXT_PUBLIC_* for client-side vars. VITE_* is kept for backwards compat with `npm run vite:dev`.

# Main social app Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Embedded ScoreHub (livescore) uses its own Supabase project.
# Optional overrides — defaults to the ScoreHub project (vgofxfjbcaplgrhodxmn).
NEXT_PUBLIC_SCOREHUB_SUPABASE_URL=
NEXT_PUBLIC_SCOREHUB_SUPABASE_ANON_KEY=
VITE_SCOREHUB_SUPABASE_URL=
VITE_SCOREHUB_SUPABASE_ANON_KEY=

# Site URL for SEO (canonical, OG)
NEXT_PUBLIC_SITE_URL=
VITE_SITE_URL=

# Web Push (embedded ScoreHub background notifications)
# Generate with: deno run --allow-net Livescoredashboard2/supabase/functions/send-push-notification/generate-vapid-keys.ts
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=

# Optional API integrations (server-only RAPIDAPI_KEY + client NEXT_PUBLIC_RAPIDAPI_KEY mirror)
RAPIDAPI_KEY=
RAPIDAPI_HOST=tiktok-scraper7.p.rapidapi.com
NEXT_PUBLIC_RAPIDAPI_KEY=
VITE_RAPIDAPI_KEY=
VITE_ALLSPORTS_API_HOST=
NEXT_PUBLIC_ALLSPORTS_API_HOST=

NEXT_PUBLIC_ENABLE_LIVE_SPORTS_API=false
VITE_ENABLE_LIVE_SPORTS_API=false
NEXT_PUBLIC_ENABLE_ALLSPORTS_API=false
VITE_ENABLE_ALLSPORTS_API=false
NEXT_PUBLIC_ENABLE_LIVE_TRANSFERS_API=false
VITE_ENABLE_LIVE_TRANSFERS_API=false

# Paystack (client)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
VITE_PAYSTACK_PUBLIC_KEY=
